# Copy this file to .env and fill in your own Supabase project's values.
# These two are safe to expose client-side — the anon key only grants what
# Row Level Security allows (see supabase/migrations/*.sql).

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ---------------------------------------------------------------------------
# NOT read from this file. Set these as Supabase Edge Function secrets
# instead (Project Settings -> Edge Functions -> Secrets, or
# `supabase secrets set KEY=value`) — never commit or expose them client-side.
# ---------------------------------------------------------------------------
#
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>       # bypasses RLS — server-side only
# OPENAI_API_KEY=<openai-api-key>                    # optional; ai-teacher-chat
#                                                     # falls back to canned
#                                                     # responses without it
# RESEND_API_KEY=<resend-api-key>                    # optional; welcome email
#                                                     # + weekly digest silently
#                                                     # don't send without it —
#                                                     # everything else still works
# EMAIL_FROM=SmartClass Zambia <hello@yourdomain.com> # requires a Resend-verified
#                                                     # sending domain; their own
#                                                     # onboarding@resend.dev works
#                                                     # for testing before that
# LIVEAVATAR_API_KEY=<api-key-from-app.liveavatar.com> # optional; real-time video
#                                                     # avatar. Without it, every
#                                                     # persona just uses its
#                                                     # illustrated SVG avatar —
#                                                     # nothing breaks either way

# ---------------------------------------------------------------------------
# Optional. Read by middleware.ts (frontend build, not an Edge Function
# secret) — safe to set as a normal Netlify/Vercel env var. Only needed if
# you've configured a real DNS record + custom domain for an admin
# subdomain; leave unset and the admin panel just stays at /admin and
# /admin/login on your main domain, which always works regardless.
# ---------------------------------------------------------------------------
#
# ADMIN_SUBDOMAIN_HOST=admin.yourdomain.com

# ---------------------------------------------------------------------------
# Only used by scripts/run-ai-evaluation.js (npm run eval:ai), run manually
# from a developer machine or CI — never read by the deployed app itself.
# Put these in your local shell env or a CI secret store, not .env (this
# file's values do get bundled into the Next.js build).
# ---------------------------------------------------------------------------
#
# EVAL_TEST_EMAIL=<a real pupil account's email>
# EVAL_TEST_PASSWORD=<that account's password>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # optional — persists results
#                                                 # to ai_eval_runs history;
#                                                 # without it the script still
#                                                 # runs and reports, just
#                                                 # doesn't save history
# EVAL_PASS_THRESHOLD=70                         # optional, 0-100, default 70
